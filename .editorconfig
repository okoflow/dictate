root = true

[*]
charset                  = utf-8
end_of_line              = lf
indent_size              = 2
indent_style             = space
insert_final_newline     = true
trim_trailing_whitespace = true

[*.swift]
indent_size = 4

[{Makefile,*.plist}]
indent_style = tab

[*.sh]
binary_next_line   = true
shell_variant      = bash
simplify           = true
switch_case_indent = true
